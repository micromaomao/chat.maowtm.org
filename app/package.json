{
  "name": "chat.maowtm.org",
  "version": "0.4.0",
  "private": true,
  "engines": { "node": ">=22.16.0" },
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx",
    "generate-api-client": "openapi -i ../api.json -o api.client.dist -c fetch",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run generate-api-client && parcel build src/index.html --public-url / && cp public/_headers dist/_headers",
    "dev": "npm run build && wrangler dev",
    "parcel": "npm run generate-api-client && parcel src/index.html --public-url / --port 8000",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "reembed": "tsx scripts/reembed.ts",
    "test": "jest && vitest run",
    "test:unit": "jest",
    "test:worker": "vitest run",
    "test:staging": "tsx tests/staging-smoke.ts"
  },
  "alias": {
    "app": "./src/app",
    "lib": "./src/lib"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.6",
    "hono": "^4.13.21",
    "pg": "^8.16.3",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@fluentui/react-components": "^9.20.4",
    "@fluentui/react-icons": "^2.0.202",
    "@jest/globals": "^29.6.2",
    "@cloudflare/vitest-plugin": "^1.9.1",
    "@cloudflare/workers-types": "^5.20261123.1",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/react": "18.2.7",
    "@types/react-dom": "18.2.4",
    "@typescript-eslint/eslint-plugin": "^6.1.0",
    "@typescript-eslint/parser": "^6.1.0",
    "buffer": "^6.0.3",
    "eslint": "8.41.0",
    "eslint-plugin-react": "^7.33.0",
    "dotenv": "^18.0.10",
    "jest": "^29.6.2",
    "openapi-typescript-codegen": "^0.25.0",
    "parcel": "^2.9.3",
    "process": "^0.11.10",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router-dom": "^6.14.2",
    "ts-jest": "^29.1.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1",
    "wrangler": "^4.156.0"
  }
}
