{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maowtm-chat",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "f1ce40f2f7f74bc1a7fa33e66503654e"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "CHAT_SESSION", "class_name": "ChatSessionObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatSessionObject"] }],
  "rules": [{ "type": "Text", "globs": ["**/*.txt"], "fallthrough": true }],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false }
  },
  "limits": { "cpu_ms": 30000 }
}
