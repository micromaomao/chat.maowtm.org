{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "CommonJS",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "app/*": ["./src/app/*"],
      "lib/*": ["./src/lib/*"],
      "db/*": ["./src/db/*"]
    }
  },
  "include": ["src/app/**/*.ts", "src/app/**/*.tsx", "src/assets.d.ts"],
  "exclude": ["node_modules"]
}
